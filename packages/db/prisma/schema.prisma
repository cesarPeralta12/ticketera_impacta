// Modelo de datos — Plataforma de Ticketing Impacta
//
// Convenciones:
// - Montos: enteros en la unidad mínima de la moneda (ver @ticketera/core/money).
// - Fechas: siempre UTC. La zona horaria del recinto está en Venue.timezone.
// - Estados de orden/pago/entrada: deben coincidir con @ticketera/core/status
//   (src/core-sync.ts falla el typecheck si divergen).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────── Organizadores y staff ─────────────────────────

enum OrganizationStatus {
  ACTIVE
  /// Sus cuentas no entran al panel y sus eventos no se muestran ni se venden.
  SUSPENDED
}

/// IMPACTA (isPlatform) y cada organizador al que le da el servicio. Todo lo de un
/// organizador (eventos, recintos, ventas, puerta, cuentas) cuelga de su organización:
/// un organizador nunca ve lo de otro.
model Organization {
  id           String             @id @default(cuid())
  name         String
  slug         String             @unique
  currency     String             @db.Char(3)
  /// La dueña de la plataforma: sus administradores ven y gestionan a todos los organizadores.
  isPlatform   Boolean            @default(false)
  status       OrganizationStatus @default(ACTIVE)
  taxId        String?
  contactEmail String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  members Membership[]
  venues  Venue[]
  events  Event[]
  clients Client[]
}

/// Cliente u organizador de IMPACTA: dueño de uno o varios eventos. Sus usuarios (rol CLIENT)
/// solo ven sus propios eventos, y solo mientras IMPACTA les habilita el acceso.
model Client {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  /// NIT, para facturación.
  taxId          String?
  contactEmail   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  events       Event[]
  memberships  Membership[]

  @@unique([organizationId, name])
}

/// Usuario del panel: organizador, administrador u operador de puerta.
/// Separado de Customer para que las sesiones de comprador y organizador nunca se mezclen.
model StaffUser {
  id                 String   @id @default(cuid())
  email              String   @unique
  name               String
  /// bcrypt. Las cuentas del panel las crea un OWNER/ADMIN: no hay registro público.
  passwordHash       String
  active             Boolean  @default(true)
  emailVerified      Boolean  @default(false)
  /// Creada con contraseña temporal: tiene que cambiarla al entrar.
  mustChangePassword Boolean  @default(false)
  image              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  memberships     Membership[]
  scans           AccessScan[]
  issuedOrders    Order[]
  doorAssignments DoorAssignment[]
  deviceTokens    DeviceToken[]
}

/// Funciones (y opcionalmente una puerta) que un portero puede descargar y controlar
/// en la app móvil. Sin asignación, el portero no ve ningún evento.
model DoorAssignment {
  id            String   @id @default(cuid())
  userId        String
  sessionId     String
  /// Vacío = todas las puertas de la función.
  accessPointId String?
  createdAt     DateTime @default(now())

  user        StaffUser    @relation(fields: [userId], references: [id], onDelete: Cascade)
  session     EventSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  accessPoint AccessPoint? @relation(fields: [accessPointId], references: [id], onDelete: SetNull)

  @@unique([userId, sessionId])
  @@index([sessionId])
}

/// Sesión de la app móvil: token opaco (se guarda solo su hash), un dispositivo por token.
/// Se puede revocar desde el panel; al revocarlo el teléfono pierde el acceso.
model DeviceToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  deviceId   String
  deviceName String
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  user StaffUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum StaffRole {
  /// IMPACTA: todo el ecosistema.
  OWNER
  ADMIN
  /// Puerta: solo la aplicación de control de acceso.
  OPERATOR
  /// Boletería: solo el POS.
  CASHIER
  /// Organizador/cliente: solo sus eventos, mientras su acceso temporal esté abierto.
  CLIENT
}

model Membership {
  id             String    @id @default(cuid())
  organizationId String
  userId         String
  role           StaffRole
  /// Solo para rol CLIENT: el cliente cuyos eventos puede ver.
  clientId       String?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         StaffUser    @relation(fields: [userId], references: [id], onDelete: Cascade)
  client       Client?      @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
}

// ───────────────────────────── Compradores ──────────────────────────────

model Customer {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  /// bcrypt. Comprar no exige cuenta: la cuenta sirve para ver "Mis entradas".
  passwordHash  String
  emailVerified Boolean  @default(false)
  image         String?
  /// RUT / DNI, solo si las entradas son nominativas.
  documentId    String?
  phone         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  orders  Order[]
  tickets Ticket[]
}

// ─────────────────────────────── Recintos ───────────────────────────────

model Venue {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  address        String?
  city           String?
  /// Zona horaria IANA. Bolivia: "America/La_Paz".
  timezone       String   @default("America/La_Paz")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id])
  sections     Section[]
  sessions     EventSession[]
  accessPoints AccessPoint[]
}

enum SeatingMode {
  GENERAL_ADMISSION
  RESERVED
}

/// Área física del recinto: "Cancha", "Platea Baja", "Palco 3".
model Section {
  id          String      @id @default(cuid())
  venueId     String
  name        String
  seatingMode SeatingMode
  /// GENERAL_ADMISSION: aforo. RESERVED: cantidad de asientos.
  capacity    Int
  sortOrder   Int         @default(0)
  color       String      @default("#F5B700")
  /// Receta de la forma (grilla o arco) con la que el editor generó las butacas.
  layout      Json?

  venue        Venue         @relation(fields: [venueId], references: [id], onDelete: Cascade)
  seats        Seat[]
  ticketTypes  TicketType[]
  accessPoints AccessPoint[]

  @@unique([venueId, name])
}

model Seat {
  id        String @id @default(cuid())
  sectionId String
  row       String
  /// String porque existen asientos como "12A".
  number    String
  /// Texto para mostrar, ej. "Fila F · 12".
  label     String
  /// Posición en el plano, para el mapa de asientos.
  x         Float?
  y         Float?

  section    Section     @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]
  tickets    Ticket[]

  @@unique([sectionId, row, number])
}

// ──────────────────────────────── Eventos ───────────────────────────────

enum EventStatus {
  DRAFT
  /// Un organizador lo envió: espera que IMPACTA lo apruebe para salir en la web.
  PENDING_REVIEW
  PUBLISHED
  CANCELLED
}

/// TICKETING: venta online/POS con precios. GUEST_LIST: evento chico con lista de invitados,
/// sin venta ni marketplace.
enum EventMode {
  TICKETING
  GUEST_LIST
}

enum EventCategory {
  CONCIERTO
  TEATRO
  FESTIVAL
  DEPORTES
  CONFERENCIA
  FIESTA
  ARTE
  OTRO
}

model Event {
  id                  String        @id @default(cuid())
  organizationId      String
  slug                String        @unique
  title               String
  description         String?
  imageUrl            String?
  category            EventCategory @default(OTRO)
  status              EventStatus   @default(DRAFT)
  mode                EventMode     @default(TICKETING)
  /// Cliente/organizador dueño del evento (null = evento propio de IMPACTA).
  clientId            String?
  /// Espacio temporal del cliente: IMPACTA lo habilita y se cierra solo en clientAccessUntil.
  clientAccessEnabled Boolean       @default(false)
  clientAccessUntil   DateTime?
  publishedAt         DateTime?
  /// Revisión de IMPACTA: cuándo lo enviaron y, si lo devolvió, qué hay que corregir.
  submittedAt         DateTime?
  reviewNote          String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id])
  client       Client?        @relation(fields: [clientId], references: [id])
  sessions     EventSession[]

  @@index([organizationId, status])
  @@index([clientId])
}

/// Una función (fecha y hora) de un evento. El inventario se vende por función.
model EventSession {
  id                     String    @id @default(cuid())
  eventId                String
  venueId                String
  startsAt               DateTime
  endsAt                 DateTime?
  doorsOpenAt            DateTime?
  salesStartAt           DateTime?
  salesEndAt             DateTime?
  cancelledAt            DateTime?
  /// Sala de espera para ventas de alta demanda.
  queueEnabled           Boolean   @default(false)
  /// Cuántos compradores pueden estar comprando a la vez cuando la cola está activa.
  maxConcurrentCheckouts Int?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  event           Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  venue           Venue            @relation(fields: [venueId], references: [id])
  ticketTypes     TicketType[]
  tickets         Ticket[]
  scans           AccessScan[]
  doorAssignments DoorAssignment[]
  queue           QueueEntry[]

  @@index([eventId, startsAt])
}

/// Tipo de entrada a la venta en una función: "General", "VIP", "Preventa 1".
///
/// Disponibilidad = capacity − entradas emitidas − ítems de órdenes PENDING_PAYMENT
/// no expiradas. La reserva debe ser atómica (UPDATE condicional o lock de fila):
/// se diseña en Sprint 0 y se implementa en Sprint 2, antes de vender nada.
model TicketType {
  id               String         @id @default(cuid())
  sessionId        String
  /// Sección física asociada. Obligatoria si la sección es RESERVED.
  sectionId        String?
  name             String
  description      String?
  unitAmount       Int
  currency         String         @db.Char(3)
  capacity         Int
  maxPerOrder      Int            @default(10)
  salesStartAt     DateTime?
  salesEndAt       DateTime?
  /// Preventa: se muestra como tal y solo vende hasta salesEndAt.
  presale          Boolean        @default(false)
  /// Descuento de preventa sobre el mismo tipo de entrada: durante la ventana se cobra
  /// unitAmount menos este porcentaje; fuera de ella, el precio normal.
  discountPercent  Int?
  discountStartsAt DateTime?
  discountEndsAt   DateTime?
  sortOrder        Int            @default(0)
  /// Cómo se lee esta entrada en puerta: solo QR, solo código de barras, NFC o varias.
  accessMethods    AccessMethod[] @default([QR])
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  session    EventSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  section    Section?     @relation(fields: [sectionId], references: [id])
  orderItems OrderItem[]
  tickets    Ticket[]

  @@index([sessionId])
}

// ─────────────────────────── Órdenes y pagos ────────────────────────────

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  EXPIRED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

/// Por dónde se emitió la orden. Todas descuentan del mismo inventario.
enum OrderChannel {
  ONLINE
  /// Boletería presencial.
  POS
  /// Invitación o cortesía (sin cobro).
  GUEST
}

/// Una orden PENDING_PAYMENT con expiresAt futuro ES la reserva temporal de inventario.
model Order {
  id             String       @id @default(cuid())
  /// Código legible para soporte (ver @ticketera/core/codes).
  code           String       @unique
  customerId     String?
  buyerEmail     String
  buyerName      String
  buyerDocument  String?
  status         OrderStatus  @default(PENDING_PAYMENT)
  channel        OrderChannel @default(ONLINE)
  /// Staff que vendió en boletería o emitió la invitación.
  issuedById     String?
  currency       String       @db.Char(3)
  subtotalAmount Int
  feeAmount      Int          @default(0)
  totalAmount    Int
  expiresAt      DateTime
  paidAt         DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  customer Customer?   @relation(fields: [customerId], references: [id])
  issuedBy StaffUser?  @relation(fields: [issuedById], references: [id])
  items    OrderItem[]
  payments Payment[]
  tickets  Ticket[]

  @@index([status, expiresAt])
  @@index([buyerEmail])
  @@index([channel])
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  ticketTypeId String
  seatId       String?
  quantity     Int
  /// Precio congelado al crear la orden: un cambio de precio posterior no la afecta.
  unitAmount   Int
  /// Nombre del tipo de entrada congelado al crear la orden.
  name         String

  order      Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ticketType TicketType @relation(fields: [ticketTypeId], references: [id])
  seat       Seat?      @relation(fields: [seatId], references: [id])
  tickets    Ticket[]

  @@index([orderId])
  @@index([ticketTypeId])
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  REFUNDED
  CHARGED_BACK
}

/// Un intento de pago. El estado solo cambia por confirmación server-side
/// (webhook verificado + consulta a la API de la pasarela), nunca por el navegador.
model Payment {
  id                String        @id @default(cuid())
  orderId           String
  /// "mercadopago", "webpay", ... se define en Sprint 0.
  provider          String
  providerPaymentId String?
  status            PaymentStatus @default(PENDING)
  /// Estado crudo informado por la pasarela, para auditoría.
  providerStatus    String?
  amount            Int
  currency          String        @db.Char(3)
  approvedAt        DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id])

  @@unique([provider, providerPaymentId])
  @@index([orderId])
}

/// Registro crudo de cada notificación de la pasarela: idempotencia y trazabilidad.
/// Si el mismo webhook llega dos veces, el @@unique impide procesarlo dos veces.
model WebhookEvent {
  id          String    @id @default(cuid())
  provider    String
  externalId  String
  topic       String?
  payload     Json
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  error       String?

  @@unique([provider, externalId])
  @@index([processedAt])
}

// ─────────────────────────── Entradas y acceso ──────────────────────────

enum TicketStatus {
  VALID
  USED
  CANCELLED
}

model Ticket {
  id           String       @id @default(cuid())
  /// Identificador público que viaja en el QR.
  code         String       @unique
  orderId      String
  orderItemId  String
  ticketTypeId String
  sessionId    String
  seatId       String?
  customerId   String?
  holderName   String?
  status       TicketStatus @default(VALID)
  issuedAt     DateTime     @default(now())
  usedAt       DateTime?
  cancelledAt  DateTime?

  order      Order        @relation(fields: [orderId], references: [id])
  orderItem  OrderItem    @relation(fields: [orderItemId], references: [id])
  ticketType TicketType   @relation(fields: [ticketTypeId], references: [id])
  session    EventSession @relation(fields: [sessionId], references: [id])
  seat       Seat?        @relation(fields: [seatId], references: [id])
  customer   Customer?    @relation(fields: [customerId], references: [id])
  scans      AccessScan[]

  // Para asientos numerados se agregará un índice único parcial
  // (sessionId, seatId) WHERE status <> 'CANCELLED' mediante SQL en la migración:
  // es la última barrera contra la doble venta.
  @@index([sessionId, status])
  @@index([orderId])
}

/// Puerta o punto de control: "Puerta 1", "Acceso VIP".
///
/// Si tiene secciones asignadas, solo acepta entradas de esas secciones. Además de ordenar
/// el ingreso, evita el doble ingreso sin conexión: una misma entrada no puede ser aceptada
/// por dos puertas distintas que estén offline a la vez.
model AccessPoint {
  id      String @id @default(cuid())
  venueId String
  name    String

  venue       Venue            @relation(fields: [venueId], references: [id], onDelete: Cascade)
  scans       AccessScan[]
  sections    Section[]
  assignments DoorAssignment[]

  @@unique([venueId, name])
}

enum ScanResult {
  ACCEPTED
  ALREADY_USED
  NOT_FOUND
  CANCELLED
  WRONG_SESSION
  /// La entrada es de una sección que no entra por esta puerta.
  WRONG_GATE
  INVALID
  /// La entrada no se puede leer con ese método (ej. QR en una entrada solo NFC).
  METHOD_NOT_ALLOWED
}

/// Formas de leer una entrada en puerta. Se configura por tipo de entrada.
enum AccessMethod {
  QR
  BARCODE
  NFC
}

/// Cada lectura en puerta, aceptada o rechazada: es el historial de auditoría del acceso.
model AccessScan {
  id            String     @id @default(cuid())
  sessionId     String
  ticketId      String?
  accessPointId String?
  operatorId    String?
  result        ScanResult
  rawCode       String
  deviceId      String?
  /// Hora del dispositivo (relevante si la lectura se hizo offline).
  scannedAt     DateTime   @default(now())
  /// Se completa cuando la lectura llega por sincronización offline.
  syncedAt      DateTime?
  /// La validó el dispositivo sin conexión (contra la lista sincronizada).
  offline       Boolean    @default(false)
  /// Id que genera la app de puerta por lectura: si reenvía la misma al sincronizar, no se duplica.
  clientScanId  String?    @unique
  /// Cómo se leyó: QR, BARCODE, NFC o MANUAL (código escrito a mano).
  method        String?

  session     EventSession @relation(fields: [sessionId], references: [id])
  ticket      Ticket?      @relation(fields: [ticketId], references: [id])
  accessPoint AccessPoint? @relation(fields: [accessPointId], references: [id])
  operator    StaffUser?   @relation(fields: [operatorId], references: [id])

  @@index([sessionId, scannedAt])
  @@index([ticketId])
}

// ──────────────────────────── Cola virtual ──────────────────────────────

/// Un lugar en la sala de espera de una función. Vive en Postgres para que la cola sea
/// la misma en todos los servidores (la versión en memoria solo funciona con uno).
/// El token es aleatorio, lo genera el servidor y viaja en una cookie httpOnly.
model QueueEntry {
  id          String    @id @default(cuid())
  sessionId   String
  token       String
  joinedAt    DateTime  @default(now())
  /// Cuándo se le permitió pasar a comprar.
  admittedAt  DateTime?
  /// Fin del turno para comprar; después debe volver a la fila.
  expiresAt   DateTime?
  /// Terminó (creó su orden): libera su lugar para el siguiente.
  completedAt DateTime?

  session EventSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, token])
  @@index([sessionId, admittedAt, joinedAt])
}

// ─────────────────────────────── Auditoría ──────────────────────────────

/// Operaciones sensibles: publicar evento, cambiar precios, reembolsar, anular entrada...
model AuditLog {
  id        String   @id @default(cuid())
  /// "staff" | "customer" | "system"
  actorType String
  actorId   String?
  /// Ej. "event.publish", "order.refund", "ticket.cancel".
  action    String
  entity    String
  entityId  String
  data      Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}
