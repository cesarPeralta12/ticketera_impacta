// Modelo de datos — Plataforma de Ticketing Impacta
//
// Convenciones:
// - Montos: enteros en la unidad mínima de la moneda (ver @ticketera/core/money).
// - Fechas: siempre UTC. La zona horaria del recinto está en Venue.timezone.
// - Estados de orden/pago/entrada: deben coincidir con @ticketera/core/status
//   (src/core-sync.ts falla el typecheck si divergen).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────── Organizadores y staff ─────────────────────────

enum OrganizationStatus {
  ACTIVE
  /// Sus cuentas no entran al panel y sus eventos no se muestran ni se venden.
  SUSPENDED
}

/// IMPACTA (isPlatform) y cada organizador al que le da el servicio. Todo lo de un
/// organizador (eventos, recintos, ventas, puerta, cuentas) cuelga de su organización:
/// un organizador nunca ve lo de otro.
model Organization {
  id              String             @id @default(cuid())
  name            String
  slug            String             @unique
  currency        String             @db.Char(3)
  /// La dueña de la plataforma: sus administradores ven y gestionan a todos los organizadores.
  isPlatform      Boolean            @default(false)
  /// Organizador de eventos o boliche: un boliche trabaja con noches, mesas, barra y free por horario.
  kind            OrganizationKind   @default(EVENTS)
  status          OrganizationStatus @default(ACTIVE)
  taxId           String?
  contactEmail    String?
  /// Máximo de eventos activos (borrador, en revisión o publicados que no pasaron) que puede tener a la vez.
  /// Nulo = sin límite. Lo fija IMPACTA; la plataforma misma no tiene límite.
  maxActiveEvents Int?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  members    Membership[]
  promoCodes PromoCode[]
  ticketArts TicketArt[]
  venues     Venue[]
  events     Event[]
  clients    Client[]
}

/// Cliente u organizador de IMPACTA: dueño de uno o varios eventos. Sus usuarios (rol CLIENT)
/// solo ven sus propios eventos, y solo mientras IMPACTA les habilita el acceso.
model Client {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  /// NIT, para facturación.
  taxId          String?
  contactEmail   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  events       Event[]
  memberships  Membership[]

  @@unique([organizationId, name])
}

/// Usuario del panel: organizador, administrador u operador de puerta.
/// Separado de Customer para que las sesiones de comprador y organizador nunca se mezclen.
model StaffUser {
  id                 String   @id @default(cuid())
  email              String   @unique
  name               String
  /// bcrypt. Las cuentas del panel las crea un OWNER/ADMIN: no hay registro público.
  passwordHash       String
  active             Boolean  @default(true)
  emailVerified      Boolean  @default(false)
  /// Creada con contraseña temporal: tiene que cambiarla al entrar.
  mustChangePassword Boolean  @default(false)
  /// Sube al cambiar la contraseña o al "cerrar todas las sesiones": las sesiones web anteriores dejan de valer.
  sessionVersion     Int      @default(0)
  image              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  memberships     Membership[]
  scans           AccessScan[]
  issuedOrders    Order[]
  doorAssignments DoorAssignment[]
  deviceTokens    DeviceToken[]
  emailTokens     EmailToken[]
  consumptions    ConsumptionRedemption[]
  printBatches    PrintBatch[]
  printedSales    Ticket[]                @relation("PrintedSoldBy")
  settlements     PrintSettlement[]
  importBatches   ImportBatch[]
  seatHolds       SeatHold[]
}

/// Funciones (y opcionalmente una puerta) que un portero puede descargar y controlar
/// en la app móvil. Sin asignación, el portero no ve ningún evento.
model DoorAssignment {
  id            String   @id @default(cuid())
  userId        String
  sessionId     String
  /// Vacío = todas las puertas de la función.
  accessPointId String?
  createdAt     DateTime @default(now())

  user        StaffUser    @relation(fields: [userId], references: [id], onDelete: Cascade)
  session     EventSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  accessPoint AccessPoint? @relation(fields: [accessPointId], references: [id], onDelete: SetNull)

  @@unique([userId, sessionId])
  @@index([sessionId])
}

/// Sesión de la app móvil: token opaco (se guarda solo su hash), un dispositivo por token.
/// Se puede revocar desde el panel; al revocarlo el teléfono pierde el acceso.
model DeviceToken {
  id               String    @id @default(cuid())
  userId           String
  tokenHash        String    @unique
  deviceId         String
  deviceName       String
  createdAt        DateTime  @default(now())
  lastSeenAt       DateTime  @default(now())
  /// Vencimiento del token de acceso (corto: se renueva con el token de renovación).
  expiresAt        DateTime
  revokedAt        DateTime?
  /// Token de renovación (hash). Se cambia por uno nuevo en cada uso; el anterior queda en prevRefreshHash
  /// para detectar que alguien lo reutiliza (robo) y cerrar la sesión.
  refreshHash      String?   @unique
  prevRefreshHash  String?   @unique
  refreshExpiresAt DateTime?
  rotatedAt        DateTime?
  /// Dónde y con qué se inició la sesión (para la lista de dispositivos).
  ip               String?
  appVersion       String?
  platform         String?

  user StaffUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum StaffRole {
  /// IMPACTA: todo el ecosistema.
  OWNER
  ADMIN
  /// Puerta: solo la aplicación de control de acceso.
  OPERATOR
  /// Boletería: solo el POS.
  CASHIER
  /// Organizador/cliente: solo sus eventos, mientras su acceso temporal esté abierto.
  CLIENT
}

model Membership {
  id             String    @id @default(cuid())
  organizationId String
  userId         String
  role           StaffRole
  /// Solo para rol CLIENT: el cliente cuyos eventos puede ver.
  clientId       String?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         StaffUser    @relation(fields: [userId], references: [id], onDelete: Cascade)
  client       Client?      @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
}

// ───────────────────────────── Compradores ──────────────────────────────

model Customer {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String
  /// bcrypt. Comprar exige cuenta: nombre, email y carnet salen de aquí.
  passwordHash   String
  emailVerified  Boolean  @default(false)
  image          String?
  /// Carnet de identidad, normalizado (mayúsculas, sin espacios ni guiones). Obligatorio para comprar
  /// y único: una persona, una cuenta. Nulo solo en cuentas antiguas, que deben completarlo.
  documentId     String?  @unique
  phone          String?
  /// Igual que en StaffUser: subirla cierra todas las sesiones del comprador.
  sessionVersion Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  orders            Order[]
  tickets           Ticket[]
  emailTokens       EmailToken[]
  transfersSent     TicketTransfer[]  @relation("TransfersSent")
  transfersReceived TicketTransfer[]  @relation("TransfersReceived")
  promoRedemptions  PromoRedemption[]
}

enum TransferStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
  EXPIRED
}

/// Una entrada que su titular le ofrece a otra persona registrada. Al aceptarla, la entrada recibe un
/// código nuevo (el anterior deja de valer) y pasa a la cuenta de quien la aceptó.
model TicketTransfer {
  id             String         @id @default(cuid())
  ticketId       String
  fromCustomerId String
  toCustomerId   String
  status         TransferStatus @default(PENDING)
  /// Solo si se aceptó: el código que dejó de valer y el nuevo.
  oldCode        String?
  newCode        String?
  createdAt      DateTime       @default(now())
  expiresAt      DateTime
  resolvedAt     DateTime?

  ticket Ticket   @relation(fields: [ticketId], references: [id])
  from   Customer @relation("TransfersSent", fields: [fromCustomerId], references: [id])
  to     Customer @relation("TransfersReceived", fields: [toCustomerId], references: [id])

  @@index([ticketId, status])
  @@index([toCustomerId, status])
  @@index([fromCustomerId, status, createdAt])
}

enum EmailTokenPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}

/// Enlace de un solo uso que se manda por correo (confirmar el email, cambiar la contraseña).
/// Solo se guarda el hash del token: quien lea la base no puede usar los enlaces pendientes.
model EmailToken {
  id          String            @id @default(cuid())
  purpose     EmailTokenPurpose
  tokenHash   String            @unique
  customerId  String?
  staffUserId String?
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime          @default(now())

  customer  Customer?  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  staffUser StaffUser? @relation(fields: [staffUserId], references: [id], onDelete: Cascade)

  @@index([customerId, purpose, createdAt])
  @@index([staffUserId, purpose, createdAt])
}

// ─────────────────────────────── Recintos ───────────────────────────────

model Venue {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  address        String?
  city           String?
  /// Zona horaria IANA. Bolivia: "America/La_Paz".
  timezone       String   @default("America/La_Paz")
  /// Plano de un boliche: escenario, barras, DJ, entrada, baños y textos (no se venden). Ver club-map.ts.
  mapItems       Json?
  /// Para el comprador: cómo llegar y por dónde entrar, enlace de mapa (https), estacionamiento y accesibilidad.
  directions     String?
  mapUrl         String?
  parking        String?
  accessibility  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id])
  sections     Section[]
  sessions     EventSession[]
  accessPoints AccessPoint[]
  zones        AccessZone[]
  planImage    VenuePlanImage?
}

enum SeatingMode {
  GENERAL_ADMISSION
  RESERVED
}

/// Área física del recinto: "Cancha", "Platea Baja", "Palco 3".
model Section {
  id          String      @id @default(cuid())
  venueId     String
  name        String
  seatingMode SeatingMode
  /// GENERAL_ADMISSION: aforo. RESERVED: cantidad de asientos.
  capacity    Int
  sortOrder   Int         @default(0)
  color       String      @default("#F5B700")
  /// Receta de la forma (grilla o arco) con la que el editor generó las butacas.
  layout      Json?

  venue        Venue         @relation(fields: [venueId], references: [id], onDelete: Cascade)
  seats        Seat[]
  ticketTypes  TicketType[]
  accessPoints AccessPoint[]

  @@unique([venueId, name])
}

model Seat {
  id        String @id @default(cuid())
  sectionId String
  row       String
  /// String porque existen asientos como "12A".
  number    String
  /// Texto para mostrar, ej. "Fila F · 12".
  label     String
  /// Posición en el plano, para el mapa de asientos.
  x         Float?
  y         Float?

  section    Section             @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]
  tickets    Ticket[]
  credits    ConsumptionCredit[]
  holds      SeatHoldSeat[]

  @@unique([sectionId, row, number])
}

// ──────────────────────────────── Eventos ───────────────────────────────

enum EventStatus {
  DRAFT
  /// Un organizador lo envió: espera que IMPACTA lo apruebe para salir en la web.
  PENDING_REVIEW
  PUBLISHED
  CANCELLED
}

/// TICKETING: venta online/POS con precios. GUEST_LIST: evento chico con lista de invitados,
/// sin venta ni marketplace.
enum EventMode {
  TICKETING
  GUEST_LIST
}

enum EventCategory {
  CONCIERTO
  TEATRO
  FESTIVAL
  DEPORTES
  CONFERENCIA
  FIESTA
  ARTE
  /// Boliche, discoteca o lounge: noches que se repiten (cada función es una noche).
  BOLICHE
  OTRO
}

model Event {
  id                  String        @id @default(cuid())
  organizationId      String
  slug                String        @unique
  title               String
  description         String?
  imageUrl            String?
  category            EventCategory @default(OTRO)
  status              EventStatus   @default(DRAFT)
  mode                EventMode     @default(TICKETING)
  /// Cliente/organizador dueño del evento (null = evento propio de IMPACTA).
  clientId            String?
  /// Espacio temporal del cliente: IMPACTA lo habilita y se cierra solo en clientAccessUntil.
  clientAccessEnabled Boolean       @default(false)
  clientAccessUntil   DateTime?
  publishedAt         DateTime?
  /// Revisión de IMPACTA: cuándo lo enviaron y, si lo devolvió, qué hay que corregir.
  submittedAt         DateTime?
  reviewNote          String?
  /// ¿Los compradores pueden transferir sus entradas a otra persona registrada?
  transfersEnabled    Boolean       @default(true)
  /// Condiciones que ve el comprador. Edad mínima nula = todo público.
  minAge              Int?
  requiredDocument    String?
  dressCode           String?
  forbiddenItems      String?
  reentryPolicy       String?
  refundPolicy        String?
  /// Consultas: WhatsApp o teléfono, y correo.
  contactPhone        String?
  contactEmail        String?
  promoCodes          PromoCode[]
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id])
  client       Client?        @relation(fields: [clientId], references: [id])
  sessions     EventSession[]
  imports      ImportBatch[]

  @@index([organizationId, status])
  @@index([clientId])
}

/// Una función (fecha y hora) de un evento. El inventario se vende por función.
model EventSession {
  id                     String    @id @default(cuid())
  eventId                String
  venueId                String
  startsAt               DateTime
  /// Hora estimada de cierre (de madrugada = día siguiente). Sin ella, la boletería vende hasta 4 h después del inicio.
  endsAt                 DateTime?
  doorsOpenAt            DateTime?
  /// Hora de llegada recomendada que ve el comprador; vacía = la de las puertas.
  arrivalAt              DateTime?
  /// Última hora de ingreso de toda la función (después ya no entra nadie). Un tipo de entrada con su propio
  /// horario ("free hasta la 01:00") usa el suyo.
  lastEntryAt            DateTime?
  /// Programa: [{ time: "23:00", name: "DJ Alok", note?: "b2b" }], en la hora del recinto.
  program                Json?
  /// Ventana de venta online de toda la función: vacía = desde que se publica y hasta que empieza.
  /// El cierre puede ser durante el evento (boliches), como máximo hasta que termina.
  salesStartAt           DateTime?
  salesEndAt             DateTime?
  cancelledAt            DateTime?
  /// Sala de espera para ventas de alta demanda.
  queueEnabled           Boolean   @default(false)
  /// Cuántos compradores pueden estar comprando a la vez cuando la cola está activa.
  maxConcurrentCheckouts Int?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  event           Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  venue           Venue               @relation(fields: [venueId], references: [id])
  ticketTypes     TicketType[]
  tickets         Ticket[]
  scans           AccessScan[]
  credits         ConsumptionCredit[]
  doorAssignments DoorAssignment[]
  queue           QueueEntry[]
  seatHolds       SeatHold[]
  printBatches    PrintBatch[]

  @@index([eventId, startsAt])
}

/// Tipo de entrada a la venta en una función: "General", "VIP", "Preventa 1".
///
/// Disponibilidad = capacity − entradas emitidas − ítems de órdenes PENDING_PAYMENT
/// no expiradas. La reserva debe ser atómica (UPDATE condicional o lock de fila):
/// se diseña en Sprint 0 y se implementa en Sprint 2, antes de vender nada.
model TicketType {
  id                String         @id @default(cuid())
  sessionId         String
  /// Sección física asociada. Obligatoria si la sección es RESERVED.
  sectionId         String?
  name              String
  description       String?
  unitAmount        Int
  currency          String         @db.Char(3)
  capacity          Int
  maxPerOrder       Int            @default(10)
  salesStartAt      DateTime?
  salesEndAt        DateTime?
  /// Preventa: se muestra como tal y solo vende hasta salesEndAt.
  presale           Boolean        @default(false)
  /// Descuento de preventa sobre el mismo tipo de entrada: durante la ventana se cobra
  /// unitAmount menos este porcentaje; fuera de ella, el precio normal.
  discountPercent   Int?
  discountStartsAt  DateTime?
  discountEndsAt    DateTime?
  sortOrder         Int            @default(0)
  /// Cómo se lee esta entrada en puerta: solo QR, solo código de barras, NFC o varias.
  accessMethods     AccessMethod[] @default([QR])
  /// DYNAMIC: solo QR que cambia cada 30 s, solo venta online. No se puede cambiar una vez que hay ventas.
  qrMode            QrMode         @default(STATIC)
  /// ENTRY: una persona. TABLE: mesa o lounge para varias personas (cada una recibe su QR); el cupo se cuenta en mesas.
  kind              TicketKind     @default(ENTRY)
  /// Personas que entran con cada unidad: 1 en una entrada; en una mesa, las que incluye.
  peoplePerUnit     Int            @default(1)
  /// Consumo incluido en barra por unidad (centavos): el "consumo mínimo" de una mesa o el trago de una entrada.
  consumptionAmount Int?
  /// Válida para entrar solo hasta esta hora (ej. "free hasta la 01:00"): después se rechaza en puerta.
  entryUntil        DateTime?
  /// Cuántas veces puede entrar: 1 = sin reingreso (lo de siempre); 0 = sin límite.
  maxEntries        Int            @default(1)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  session      EventSession        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  section      Section?            @relation(fields: [sectionId], references: [id])
  /// Zonas que abre. Vacío: las de siempre (según las secciones de cada puerta).
  zones        AccessZone[]        @relation("TicketTypeZones")
  orderItems   OrderItem[]
  tickets      Ticket[]
  credits      ConsumptionCredit[]
  printBatches PrintBatch[]

  @@index([sessionId])
}

// ─────────────────────────── Órdenes y pagos ────────────────────────────

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  EXPIRED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

/// Por dónde se emitió la orden. Todas descuentan del mismo inventario.
enum OrderChannel {
  ONLINE
  /// Boletería presencial.
  POS
  /// Invitación o cortesía (sin cobro).
  GUEST
  /// Entrada impresa de un lote numerado: suma a la recaudación recién cuando se marca vendida.
  PRINTED
  /// Importada desde Excel (vendida por otro medio o cortesía): con el monto que se declaró al importarla.
  IMPORT
}

/// Una orden PENDING_PAYMENT con expiresAt futuro ES la reserva temporal de inventario.
model Order {
  id               String       @id @default(cuid())
  /// Código legible para soporte (ver @ticketera/core/codes).
  code             String       @unique
  customerId       String?
  buyerEmail       String
  buyerName        String
  buyerDocument    String?
  status           OrderStatus  @default(PENDING_PAYMENT)
  channel          OrderChannel @default(ONLINE)
  /// Staff que vendió en boletería o emitió la invitación.
  issuedById       String?
  currency         String       @db.Char(3)
  subtotalAmount   Int
  feeAmount        Int          @default(0)
  /// Descuento de un código promocional (ya restado del total).
  discountAmount   Int          @default(0)
  totalAmount      Int
  expiresAt        DateTime
  paidAt           DateTime?
  /// Lote de importación del que salió (canal IMPORT).
  importBatchId    String?
  /// Cuándo se le enviaron las entradas por correo desde el panel (las importadas se envían a pedido).
  ticketsEmailedAt DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  customer        Customer?           @relation(fields: [customerId], references: [id])
  issuedBy        StaffUser?          @relation(fields: [issuedById], references: [id])
  importBatch     ImportBatch?        @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  items           OrderItem[]
  payments        Payment[]
  tickets         Ticket[]
  promoRedemption PromoRedemption?
  credits         ConsumptionCredit[]

  @@index([status, expiresAt])
  @@index([buyerEmail])
  @@index([channel])
  @@index([importBatchId])
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  ticketTypeId String
  seatId       String?
  quantity     Int
  /// Precio congelado al crear la orden: un cambio de precio posterior no la afecta.
  unitAmount   Int
  /// Nombre del tipo de entrada congelado al crear la orden.
  name         String

  order      Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ticketType TicketType @relation(fields: [ticketTypeId], references: [id])
  seat       Seat?      @relation(fields: [seatId], references: [id])
  tickets    Ticket[]

  @@index([orderId])
  @@index([ticketTypeId])
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  REFUNDED
  CHARGED_BACK
}

/// Un intento de pago. El estado solo cambia por confirmación server-side
/// (webhook verificado + consulta a la API de la pasarela), nunca por el navegador.
model Payment {
  id                String        @id @default(cuid())
  orderId           String
  /// "mercadopago", "webpay", ... se define en Sprint 0.
  provider          String
  providerPaymentId String?
  status            PaymentStatus @default(PENDING)
  /// Estado crudo informado por la pasarela, para auditoría.
  providerStatus    String?
  amount            Int
  currency          String        @db.Char(3)
  approvedAt        DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id])

  @@unique([provider, providerPaymentId])
  @@index([orderId])
}

/// Registro crudo de cada notificación de la pasarela: idempotencia y trazabilidad.
/// Si el mismo webhook llega dos veces, el @@unique impide procesarlo dos veces.
model WebhookEvent {
  id          String    @id @default(cuid())
  provider    String
  externalId  String
  topic       String?
  payload     Json
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  error       String?

  @@unique([provider, externalId])
  @@index([processedAt])
}

// ─────────────────────────── Entradas y acceso ──────────────────────────

enum TicketStatus {
  VALID
  USED
  CANCELLED
}

model Ticket {
  id             String       @id @default(cuid())
  /// Identificador público que viaja en el QR.
  code           String       @unique
  orderId        String
  orderItemId    String
  ticketTypeId   String
  sessionId      String
  seatId         String?
  customerId     String?
  holderName     String?
  /// Carnet del titular actual (si cambió por una transferencia). Vacío: es el del comprador de la orden.
  holderDocument String?
  /// Cuántas veces se transfirió; tiene un máximo por entrada.
  transferCount  Int          @default(0)
  transferredAt  DateTime?
  status         TicketStatus @default(VALID)
  issuedAt       DateTime     @default(now())
  usedAt         DateTime?
  cancelledAt    DateTime?
  /// Saldo de consumo en barra: el de su mesa (compartido) o el de la propia entrada.
  creditId       String?
  /// Tenía horario de ingreso (entryUntil) y venció sin usarse: queda anulada.
  expiredAt      DateTime?
  /// Entrada impresa: número de serie visible ("A-0001"), su lote y dónde está (ver PrintState).
  serial         String?
  printBatchId   String?
  printState     PrintState?
  /// Vendedor o RRPP que tiene el talonario.
  assignedTo     String?
  assignedAt     DateTime?
  soldAt         DateTime?
  soldById       String?
  /// Cómo se cobró: EFECTIVO, QR o TRANSFERENCIA.
  soldMethod     String?
  /// Cuántas veces se imprimió (más de una = reimpresión, queda en Seguridad).
  printedCount   Int          @default(0)
  /// Presencia: si está adentro ahora, en qué zona, cuántas veces entró y su último movimiento.
  inside         Boolean      @default(false)
  zoneId         String?
  entries        Int          @default(0)
  lastMovementAt DateTime?

  order      Order              @relation(fields: [orderId], references: [id])
  orderItem  OrderItem          @relation(fields: [orderItemId], references: [id])
  ticketType TicketType         @relation(fields: [ticketTypeId], references: [id])
  session    EventSession       @relation(fields: [sessionId], references: [id])
  seat       Seat?              @relation(fields: [seatId], references: [id])
  customer   Customer?          @relation(fields: [customerId], references: [id])
  scans      AccessScan[]
  transfers  TicketTransfer[]
  credit     ConsumptionCredit? @relation(fields: [creditId], references: [id])
  printBatch PrintBatch?        @relation(fields: [printBatchId], references: [id])
  soldBy     StaffUser?         @relation("PrintedSoldBy", fields: [soldById], references: [id])
  zone       AccessZone?        @relation(fields: [zoneId], references: [id], onDelete: SetNull)

  // Para asientos numerados se agregará un índice único parcial
  // (sessionId, seatId) WHERE status <> 'CANCELLED' mediante SQL en la migración:
  // es la última barrera contra la doble venta.
  @@unique([sessionId, serial])
  @@index([printBatchId])
  @@index([sessionId, inside, zoneId])
  @@index([sessionId, status])
  @@index([orderId])
  @@index([creditId])
}

/// Puerta o punto de control: "Puerta 1", "Acceso VIP".
///
/// Si tiene secciones asignadas, solo acepta entradas de esas secciones. Además de ordenar
/// el ingreso, evita el doble ingreso sin conexión: una misma entrada no puede ser aceptada
/// por dos puertas distintas que estén offline a la vez.
model AccessPoint {
  id        String        @id @default(cuid())
  venueId   String
  name      String
  /// IN: se entra (lo de siempre). OUT: se sale. BOTH: entra o sale según si la entrada está adentro.
  direction GateDirection @default(IN)
  /// Zona a la que da la puerta (ej. la puerta del VIP). Vacía: el ingreso general al recinto.
  zoneId    String?

  venue       Venue            @relation(fields: [venueId], references: [id], onDelete: Cascade)
  zone        AccessZone?      @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  scans       AccessScan[]
  sections    Section[]
  assignments DoorAssignment[]

  @@unique([venueId, name])
}

enum GateDirection {
  IN
  OUT
  BOTH
}

/// Zona de acceso de un recinto (Exterior, General, VIP, Súper VIP): las puertas dan a una zona, cada tipo de entrada
/// dice qué zonas abre y el panel muestra cuántas personas hay adentro de cada una.
model AccessZone {
  id       String @id @default(cuid())
  venueId  String
  name     String
  /// Orden de afuera hacia adentro: 0 exterior, 1 general, 2 VIP…
  level    Int    @default(1)
  /// Aforo de la zona (para el aforo en vivo). Vacío: sin tope propio.
  capacity Int?
  color    String @default("#2E9E6A")

  venue       Venue         @relation(fields: [venueId], references: [id], onDelete: Cascade)
  gates       AccessPoint[]
  ticketTypes TicketType[]  @relation("TicketTypeZones")
  inside      Ticket[]
  scans       AccessScan[]

  @@unique([venueId, name])
}

/// Qué pasó con una lectura aceptada: primer ingreso, reingreso, salida, cambio de zona o corrección manual.
enum PresenceMovement {
  ENTRY
  REENTRY
  EXIT
  ZONE_CHANGE
  MANUAL
}

enum ScanResult {
  ACCEPTED
  ALREADY_USED
  NOT_FOUND
  CANCELLED
  WRONG_SESSION
  /// La entrada es de una sección que no entra por esta puerta.
  WRONG_GATE
  INVALID
  /// La entrada no se puede leer con ese método (ej. QR en una entrada solo NFC).
  METHOD_NOT_ALLOWED
  /// QR dinámico auténtico pero de otro momento: una captura vieja (o un reloj muy desajustado).
  QR_EXPIRED
  /// La entrada es de QR dinámico y se leyó su código estático (impreso, de barras o escrito sin OTP).
  STATIC_NOT_ALLOWED
  /// La entrada solo valía para entrar hasta una hora (ej. "free hasta la 01:00") y ya pasó.
  OUT_OF_HOURS
  /// Entrada impresa que todavía no se vendió (lote "activada al vender"): una fotocopia o una robada no pasa.
  NOT_ACTIVATED
  /// Se leyó en una puerta de salida pero la entrada no estaba adentro.
  NOT_INSIDE
}

/// Cómo se muestra la entrada: con un QR fijo, o con uno que cambia cada 30 segundos (ver docs/qr-dinamico.md).
enum QrMode {
  STATIC
  DYNAMIC
}

/// Formas de leer una entrada en puerta. Se configura por tipo de entrada.
enum AccessMethod {
  QR
  BARCODE
  NFC
}

/// Cada lectura en puerta, aceptada o rechazada: es el historial de auditoría del acceso.
model AccessScan {
  id            String            @id @default(cuid())
  sessionId     String
  ticketId      String?
  accessPointId String?
  operatorId    String?
  result        ScanResult
  rawCode       String
  deviceId      String?
  /// Hora del dispositivo (relevante si la lectura se hizo offline).
  scannedAt     DateTime          @default(now())
  /// Se completa cuando la lectura llega por sincronización offline.
  syncedAt      DateTime?
  /// La validó el dispositivo sin conexión (contra la lista sincronizada).
  offline       Boolean           @default(false)
  /// Id que genera la app de puerta por lectura: si reenvía la misma al sincronizar, no se duplica.
  clientScanId  String?           @unique
  /// Cómo se leyó: QR, BARCODE, NFC o MANUAL (código escrito a mano).
  method        String?
  /// Lectura aceptada: si fue ingreso, reingreso, salida, cambio de zona o corrección manual. Vacío en las viejas (ingreso).
  movement      PresenceMovement?
  /// Zona en la que quedó la entrada después del movimiento.
  zoneId        String?

  session     EventSession @relation(fields: [sessionId], references: [id])
  ticket      Ticket?      @relation(fields: [ticketId], references: [id])
  accessPoint AccessPoint? @relation(fields: [accessPointId], references: [id])
  operator    StaffUser?   @relation(fields: [operatorId], references: [id])
  zone        AccessZone?  @relation(fields: [zoneId], references: [id], onDelete: SetNull)

  @@index([sessionId, scannedAt])
  @@index([ticketId])
}

// ──────────────────────────── Cola virtual ──────────────────────────────

/// Un lugar en la sala de espera de una función. Vive en Postgres para que la cola sea
/// la misma en todos los servidores (la versión en memoria solo funciona con uno).
/// El token es aleatorio, lo genera el servidor y viaja en una cookie httpOnly.
model QueueEntry {
  id          String    @id @default(cuid())
  sessionId   String
  token       String
  joinedAt    DateTime  @default(now())
  /// Cuándo se le permitió pasar a comprar.
  admittedAt  DateTime?
  /// Fin del turno para comprar; después debe volver a la fila.
  expiresAt   DateTime?
  /// Terminó (creó su orden): libera su lugar para el siguiente.
  completedAt DateTime?
  /// Última vez que la página preguntó por su turno. Quien cierra la pestaña deja de preguntar:
  /// sin esto, esos "fantasmas" bloquean la fila (esperando) o retienen un lugar (admitidos).
  lastSeenAt  DateTime  @default(now())
  /// Cuenta de quien está en la fila: una persona, un lugar (no sirve abrir varias pestañas).
  customerId  String?

  session EventSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, token])
  @@index([sessionId, customerId])
  @@index([sessionId, admittedAt, joinedAt])
}

// ─────────────────────────────── Auditoría ──────────────────────────────

/// Operaciones sensibles: publicar evento, cambiar precios, reembolsar, anular entrada...
model AuditLog {
  id             String   @id @default(cuid())
  /// "staff" | "customer" | "system"
  actorType      String
  actorId        String?
  /// Ej. "event.publish", "order.refund", "ticket.cancel".
  action         String
  entity         String
  entityId       String
  data           Json?
  /// Organización a la que pertenece el evento (para que cada organizador vea solo lo suyo). Nulo: de la plataforma o de un comprador.
  organizationId String?
  /// "info" | "warn" (logins fallidos, bloqueos, dispositivos nuevos, reutilización de tokens…).
  severity       String   @default("info")
  /// Desde dónde y con qué se hizo el cambio.
  ip             String?
  userAgent      String?
  /// Teléfono de la app de puerta (identificador estable y nombre del modelo).
  deviceId       String?
  deviceName     String?
  createdAt      DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
  @@index([action, createdAt])
  @@index([organizationId, createdAt])
  @@index([actorId, createdAt])
  @@index([ip, createdAt])
}

/// Intentos recientes para limitar abusos (login, registro, compras…). Se purgan solos pasado un día.
model RateLimitHit {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

enum PromoDiscountType {
  PERCENT
  /// Monto fijo que se descuenta de cada entrada.
  FIXED
}

/// Código promocional: descuento por porcentaje o monto fijo por entrada, con límites de uso y vigencia.
/// Puede llevar el nombre de un promotor (RRPP) y su comisión, para medir cuánto vendió cada uno.
model PromoCode {
  id                    String            @id @default(cuid())
  organizationId        String
  /// Evento al que aplica; vacío = todos los eventos de la organización.
  eventId               String?
  /// Normalizado (mayúsculas, sin espacios). Único por organización.
  code                  String
  description           String?
  discountType          PromoDiscountType
  /// PERCENT: 1 a 100. FIXED: centavos por entrada.
  discountValue         Int
  /// ¿Se suma al descuento de preventa? Por defecto no.
  combinableWithPresale Boolean           @default(false)
  /// Usos totales (órdenes). Vacío = sin límite.
  maxUses               Int?
  /// Usos por cuenta de comprador. Vacío = sin límite.
  maxUsesPerCustomer    Int?
  startsAt              DateTime?
  endsAt                DateTime?
  active                Boolean           @default(true)
  /// Promotor o RRPP al que se atribuyen las ventas con este código.
  promoterName          String?
  /// Comisión del promotor sobre lo vendido con el código (informativa, para el reporte).
  commissionPercent     Int?
  createdById           String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id])
  event        Event?            @relation(fields: [eventId], references: [id])
  redemptions  PromoRedemption[]

  @@unique([organizationId, code])
  @@index([eventId])
}

/// Un uso del código en una orden. Cuenta para los límites mientras la orden esté pagada o reservada.
model PromoRedemption {
  id             String   @id @default(cuid())
  promoCodeId    String
  orderId        String   @unique
  customerId     String?
  discountAmount Int
  createdAt      DateTime @default(now())

  promoCode PromoCode @relation(fields: [promoCodeId], references: [id])
  order     Order     @relation(fields: [orderId], references: [id])
  customer  Customer? @relation(fields: [customerId], references: [id])

  @@index([promoCodeId])
  @@index([customerId, promoCodeId])
}

enum TicketKind {
  ENTRY
  TABLE
}

/// Saldo de consumo en barra de una mesa (compartido por sus personas) o de una entrada con consumo
/// incluido. Se descuenta en la Barra con cualquiera de los QR de la mesa.
model ConsumptionCredit {
  id           String   @id @default(cuid())
  sessionId    String
  orderId      String
  ticketTypeId String
  /// Número de mesa dentro de su tipo (Mesa 1, Mesa 2…), en una zona sin butacas. Vacío en una entrada con
  /// consumo y en una mesa elegida en el mapa (esa usa seatId).
  tableNumber  Int?
  /// Mesa elegida en el mapa: la "butaca" de una sección numerada que es una mesa.
  seatId       String?
  /// Consumo incluido (centavos) y lo ya consumido.
  amount       Int
  spent        Int      @default(0)
  currency     String   @db.Char(3)
  createdAt    DateTime @default(now())

  session     EventSession            @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  order       Order                   @relation(fields: [orderId], references: [id])
  ticketType  TicketType              @relation(fields: [ticketTypeId], references: [id])
  seat        Seat?                   @relation(fields: [seatId], references: [id], onDelete: SetNull)
  tickets     Ticket[]
  redemptions ConsumptionRedemption[]

  @@unique([ticketTypeId, tableNumber])
  @@index([sessionId])
  @@index([orderId])
}

/// Un consumo cobrado contra un saldo (lo registra el personal de barra).
model ConsumptionRedemption {
  id        String   @id @default(cuid())
  creditId  String
  amount    Int
  staffId   String
  note      String?
  createdAt DateTime @default(now())

  credit ConsumptionCredit @relation(fields: [creditId], references: [id], onDelete: Cascade)
  staff  StaffUser         @relation(fields: [staffId], references: [id])

  @@index([creditId, createdAt])
}

enum OrganizationKind {
  EVENTS
  NIGHTLIFE
}

// ───────────────────────── Entradas impresas ─────────────────────────

/// A: la entrada vale desde que se imprime. B (recomendada): vale recién cuando se marca vendida.
enum PrintMode {
  VALID_ON_PRINT
  ACTIVATE_ON_SALE
}

/// Dónde está una entrada impresa. USADA es el estado de la entrada (Ticket.status = USED).
enum PrintState {
  /// En poder del organizador.
  STOCK
  /// Entregada a un vendedor o RRPP (talonario).
  ASSIGNED
  SOLD
  /// Volvió sin vender: se puede volver a entregar o anular.
  RETURNED
  /// Perdida o inválida: no abre la puerta y libera su cupo.
  VOID
}

/// Lote de entradas impresas de un tipo de entrada: numeradas, sin comprador, descuentan cupo al crearse.
model PrintBatch {
  id           String    @id @default(cuid())
  sessionId    String
  ticketTypeId String
  /// "A" -> A-0001, A-0002…
  prefix       String
  firstNumber  Int
  quantity     Int
  mode         PrintMode @default(ACTIVATE_ON_SALE)
  /// Precio de referencia por entrada (para la rendición).
  unitAmount   Int
  currency     String    @db.Char(3)
  note         String?
  artId        String?
  createdById  String
  createdAt    DateTime  @default(now())

  session     EventSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  ticketType  TicketType        @relation(fields: [ticketTypeId], references: [id])
  createdBy   StaffUser         @relation(fields: [createdById], references: [id])
  art         TicketArt?        @relation(fields: [artId], references: [id], onDelete: SetNull)
  tickets     Ticket[]
  settlements PrintSettlement[]

  @@index([sessionId])
}

/// Rendición de un vendedor: cuántas vendió y devolvió, cuánto debía entregar y cuánto entregó.
model PrintSettlement {
  id             String   @id @default(cuid())
  batchId        String
  seller         String
  sold           Int
  returned       Int
  expectedAmount Int
  receivedAmount Int
  note           String?
  staffId        String
  createdAt      DateTime @default(now())

  batch PrintBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  staff StaffUser  @relation(fields: [staffId], references: [id])

  @@index([batchId])
}

/// Arte propio de la entrada impresa (PNG o JPG): se dibuja de fondo y encima van el QR, la serie y los datos.
model TicketArt {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  mimeType       String
  data           Bytes
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  batches      PrintBatch[]

  @@index([organizationId])
}

// ───────────────────────── Importación desde Excel ─────────────────────────

enum ImportStatus {
  /// Revisado y a la espera de confirmar (todavía no descuenta cupo).
  DRAFT
  /// Confirmado: cada fila es una orden con sus entradas.
  CONFIRMED
  /// Deshecho: se anularon las entradas que no se usaron.
  UNDONE
  /// Descartado sin confirmar.
  DISCARDED
}

/// Un archivo de entradas importadas: se revisa entero (vista previa con errores por fila), se confirma todo junto
/// y se puede deshacer.
model ImportBatch {
  id          String       @id @default(cuid())
  eventId     String
  staffId     String
  fileName    String
  status      ImportStatus @default(DRAFT)
  /// Filas válidas ya resueltas (función, tipo de entrada, butaca o mesa), listas para confirmar.
  rows        Json
  /// Problemas por fila ([{ line, message }]): con errores solo se confirma dejando fuera esas filas.
  errors      Json
  /// Avisos que no impiden importar (ej. ese carnet ya tiene entrada en la función).
  warnings    Json
  totalRows   Int
  validRows   Int
  /// Entradas que se emiten (una mesa emite una por persona).
  ticketCount Int
  createdAt   DateTime     @default(now())
  confirmedAt DateTime?
  undoneAt    DateTime?

  event  Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  staff  StaffUser @relation(fields: [staffId], references: [id])
  orders Order[]

  @@index([eventId, createdAt])
}

// ───────────────────────────── Retenciones ─────────────────────────────

/// Butacas (o mesas, o sillas) apartadas de la venta en una función: para prensa, artistas o producción. El color solo
/// se ve en el panel; con el código, quien lo tenga puede comprar esas butacas en la web. Liberar = borrar la retención.
model SeatHold {
  id          String   @id @default(cuid())
  sessionId   String
  name        String
  color       String   @default("#7C3AED")
  /// Código de liberación (opcional): habilita estas butacas en la web para quien lo escriba.
  code        String?
  note        String?
  createdById String
  createdAt   DateTime @default(now())

  session   EventSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  createdBy StaffUser      @relation(fields: [createdById], references: [id])
  seats     SeatHoldSeat[]

  @@unique([sessionId, name])
  @@unique([sessionId, code])
}

/// Una butaca dentro de una retención: cada butaca está en una sola retención por función.
model SeatHoldSeat {
  holdId    String
  seatId    String
  sessionId String

  hold SeatHold @relation(fields: [holdId], references: [id], onDelete: Cascade)
  seat Seat     @relation(fields: [seatId], references: [id], onDelete: Cascade)

  @@id([holdId, seatId])
  @@unique([sessionId, seatId])
}

/// Imagen del plano real de un recinto (PNG, JPG, WebP o SVG) para calcar en los editores del panel; el comprador no
/// la ve. Va en su propia tabla para no cargarla con cada consulta del recinto.
model VenuePlanImage {
  venueId   String   @id
  mimeType  String
  data      Bytes
  /// Opacidad con la que se ve de fondo (5 a 100).
  opacity   Int      @default(40)
  updatedAt DateTime @updatedAt

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)
}
