# Copia este archivo como `.env` en la raíz del repo. Lo leen las dos apps y Prisma.

# PostgreSQL local: `npm run db:local` (sin Docker) o `docker compose up -d`. Misma URL.
DATABASE_URL="postgresql://ticketera:ticketera@localhost:5433/ticketera"

# URL pública del marketplace (enlaces en emails, retorno desde la pasarela).
WEB_URL="http://localhost:3000"

# Firma de los QR. Generar uno propio por ambiente:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Si se cambia, los QR ya emitidos dejan de validar.
TICKET_QR_SECRET="cambiar"

# Pagos. "directo" = pase directo: la compra queda pagada en el acto, SIN cobrar (hasta tener una pasarela
# real; ver docs/pasarela-de-pago.md). No lo uses para vender de verdad.
PAYMENT_PROVIDER="directo"

# Sesiones (NextAuth). Un secreto distinto por app, para que una sesión nunca sirva en la otra.
# Generar cada uno con el mismo comando de TICKET_QR_SECRET.
WEB_AUTH_SECRET="cambiar"
ADMIN_AUTH_SECRET="cambiar"

# URL pública del panel (enlaces de "olvidé mi contraseña" del personal).
ADMIN_URL="http://localhost:3001"

# Correo (confirmar el email, cambiar la contraseña y enviar las entradas).
#   MAIL_PROVIDER="console" → desarrollo: no envía nada; guarda cada correo en .dev-mail/ y muestra el enlace en la consola.
#   MAIL_PROVIDER="resend"  → envío real con Resend (https://resend.com): crear una API key y verificar el dominio.
#   MAIL_PROVIDER="smtp"    → cualquier SMTP, por ejemplo Gmail (ver SMTP_* abajo).
MAIL_PROVIDER="console"
RESEND_API_KEY=""
# Remitente. Con un dominio verificado en Resend: "Impacta <entradas@tudominio.bo>".
# Sin dominio, Resend solo entrega a tu propio correo (onboarding@resend.dev).
MAIL_FROM="Impacta <onboarding@resend.dev>"

# SMTP (solo con MAIL_PROVIDER="smtp"). Ejemplo con Gmail: activar la verificación en dos pasos de la cuenta,
# crear una "contraseña de aplicación" (myaccount.google.com/apppasswords) y usarla aquí; NO la contraseña normal.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
# Opcional: a dónde llegan las respuestas (el remitente es de "no responder").
MAIL_REPLY_TO=""
