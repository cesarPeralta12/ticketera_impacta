# Copia este archivo como `.env` en la raíz del repo. Lo leen las dos apps y Prisma.

# PostgreSQL local: `npm run db:local` (sin Docker) o `docker compose up -d`. Misma URL.
DATABASE_URL="postgresql://ticketera:ticketera@localhost:5433/ticketera"

# URL pública del marketplace (enlaces en emails, retorno desde la pasarela).
WEB_URL="http://localhost:3000"

# Firma de los QR. Generar uno propio por ambiente:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Si se cambia, los QR ya emitidos dejan de validar.
TICKET_QR_SECRET="cambiar"

# Pasarela de pago. "mock" = pasarela simulada, solo para desarrollo y staging.
PAYMENT_PROVIDER="mock"
PAYMENT_MOCK_SECRET="cambiar"

# Sesiones (NextAuth). Un secreto distinto por app, para que una sesión nunca sirva en la otra.
# Generar cada uno con el mismo comando de TICKET_QR_SECRET.
WEB_AUTH_SECRET="cambiar"
ADMIN_AUTH_SECRET="cambiar"
